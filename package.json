    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.6.1",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.9.0",
    "env-cmd": "^10.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.536.0",
    "moment": "^2.30.1",
    "next": "^15.2.9",
    "openai": "^5.5.0",
    "react": "^19.2.5",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.5",
