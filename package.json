    "react-server-dom-parcel": "^19.2.5",
    "react-server-dom-turbopack": "^19.2.5",
    "react-server-dom-webpack": "^19.2.5",
    "react-slick": "^0.30.3",
    "sass": "^1.86.0",
    "slick-carousel": "^1.8.1",
    "yup": "^1.6.1"
